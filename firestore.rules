rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedPublisher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.role in ['systemAdmin', 'publisher'];
    }

    function isEnabledSystemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.role == 'systemAdmin';
    }

    function canManageAnnouncement() {
      return isAuthorizedPublisher()
        && (isEnabledSystemAdmin()
          || resource.data.publisherUid == request.auth.uid);
    }

    function keepsLifecycleFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'publisherUid',
        'publicationStatus',
        'withdrawnAt',
        'withdrawnBy',
        'collectionStatus',
        'collectionMessage',
        'collectionStartedAt',
        'collectionStartedBy'
      ]);
    }

    function isFixedDepartment(value) {
      return value in [
        '校長', '人事室', '會計室',
        '教務處', '教學組', '註冊組', '資訊組', '設備組',
        '學務處', '生教組', '訓育組', '衛生組', '體育組', '健康中心',
        '總務處', '出納組', '文書組', '事務組',
        '輔導處', '輔導組', '特教組', '生涯組'
      ];
    }

    function canUseAnnouncementDepartment() {
      return isEnabledSystemAdmin()
        || isFixedDepartment(request.resource.data.department)
        || request.resource.data.department == get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.defaultDepartment;
    }

    function isValidImageAttachment(attachment) {
      return attachment is map
        && attachment.type == 'image'
        && attachment.id is string
        && attachment.id.size() > 0
        && attachment.url is string
        && attachment.url.matches('https://.*')
        && attachment.name is string
        && attachment.name.size() > 0;
    }

    function isValidPdfAttachment(attachment, announcementId, publisherUid) {
      return attachment is map
        && attachment.keys().hasAll(['id', 'type', 'url', 'name', 'sizeBytes', 'storagePath', 'contentType'])
        && attachment.keys().hasOnly(['id', 'type', 'url', 'name', 'sizeBytes', 'storagePath', 'contentType'])
        && attachment.type == 'pdf'
        && attachment.id is string
        && attachment.id.size() > 0
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.name.size() <= 120
        && attachment.url is string
        && attachment.url.matches('https://.*')
        && attachment.sizeBytes is int
        && attachment.sizeBytes > 0
        && attachment.sizeBytes <= 5 * 1024 * 1024
        && attachment.contentType == 'application/pdf'
        && attachment.storagePath == 'announcements/' + announcementId + '/pdf/' + publisherUid + '/' + attachment.id + '.pdf';
    }

    function isValidAttachment(attachment, announcementId, publisherUid) {
      return isValidImageAttachment(attachment)
        || isValidPdfAttachment(attachment, announcementId, publisherUid);
    }

    function hasAtMostTwoTrailingPdfs(attachments) {
      return (attachments.size() < 3 || isValidImageAttachment(attachments[0]))
        && (attachments.size() < 4 || isValidImageAttachment(attachments[1]))
        && (attachments.size() < 5 || isValidImageAttachment(attachments[2]))
        && (attachments.size() < 6 || isValidImageAttachment(attachments[3]))
        && (attachments.size() < 7 || isValidImageAttachment(attachments[4]));
    }

    function isValidAttachments(data, announcementId, publisherUid) {
      return !data.keys().hasAny(['attachments'])
        || (data.attachments is list
          && data.attachments.size() <= 7
          && (data.attachments.size() < 1 || isValidAttachment(data.attachments[0], announcementId, publisherUid))
          && (data.attachments.size() < 2 || isValidAttachment(data.attachments[1], announcementId, publisherUid))
          && (data.attachments.size() < 3 || isValidAttachment(data.attachments[2], announcementId, publisherUid))
          && (data.attachments.size() < 4 || isValidAttachment(data.attachments[3], announcementId, publisherUid))
          && (data.attachments.size() < 5 || isValidAttachment(data.attachments[4], announcementId, publisherUid))
          && (data.attachments.size() < 6 || isValidAttachment(data.attachments[5], announcementId, publisherUid))
          && (data.attachments.size() < 7 || isValidAttachment(data.attachments[6], announcementId, publisherUid))
          && hasAtMostTwoTrailingPdfs(data.attachments));
    }

    function keepsValidAttachments(announcementId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['attachments'])
        || isValidAttachments(request.resource.data, announcementId, request.resource.data.publisherUid);
    }

    function isOwnVerifiedPublisherRequest(publisherUid) {
      return request.auth != null
        && request.auth.uid == publisherUid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isValidNewPublisherRequest() {
      return request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'requestedAt',
          'lastSeenAt',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'requestedAt',
          'lastSeenAt',
          'status',
          'requestedDepartment'
        ])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && request.resource.data.requestedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['requestedDepartment'])
          || isFixedDepartment(request.resource.data.requestedDepartment)
          || request.resource.data.requestedDepartment == '其他');
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAuthorizedPublisher()
        && request.resource.data.publisherUid == request.auth.uid
        && request.resource.data.publicationStatus == 'published'
        && canUseAnnouncementDepartment()
        && isValidAttachments(request.resource.data, announcementId, request.auth.uid);
      allow update: if canManageAnnouncement()
        && keepsLifecycleFields()
        && canUseAnnouncementDepartment()
        && keepsValidAttachments(announcementId);
      allow delete: if false;
    }

    match /authorizedPublishers/{publisherUid} {
      allow get: if request.auth != null && request.auth.uid == publisherUid;
      allow list, create, update, delete: if false;
    }

    match /publisherRequests/{publisherUid} {
      allow get: if (request.auth != null && request.auth.uid == publisherUid)
        || isEnabledSystemAdmin();
      allow list: if isEnabledSystemAdmin();
      allow create: if isOwnVerifiedPublisherRequest(publisherUid)
        && isValidNewPublisherRequest();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
