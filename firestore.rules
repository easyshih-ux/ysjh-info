rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedPublisher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.role in ['systemAdmin', 'publisher'];
    }

    function isEnabledSystemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data.role == 'systemAdmin';
    }

    function canManageAnnouncement() {
      return isAuthorizedPublisher()
        && (isEnabledSystemAdmin()
          || resource.data.publisherUid == request.auth.uid);
    }

    function keepsLifecycleFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'publisherUid',
        'publicationStatus',
        'withdrawnAt',
        'withdrawnBy',
        'collectionStatus',
        'collectionMessage',
        'collectionStartedAt',
        'collectionStartedBy'
      ]);
    }

    function keepsServerManagedSummary() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hasRelatedFollowUp',
        'latestFollowUp',
        'followUpCounts'
      ]);
    }

    function keepsContentUpdateCount() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['contentUpdateCount'])
        || (request.resource.data.contentUpdateCount is int
          && request.resource.data.contentUpdateCount > 0
          && request.resource.data.contentUpdateCount == (resource.data.keys().hasAny(['contentUpdateCount']) ? resource.data.contentUpdateCount + 1 : 1)
          && changed.hasAll(['contentUpdatedAt', 'updatedAt'])
          && changed.hasAny(['academicYear', 'department', 'title', 'audiences', 'content', 'contact', 'importantEvents', 'deadlines', 'links']));
    }

    function isFixedDepartment(value) {
      return value in [
        '校長', '人事室', '會計室',
        '教務處', '教學組', '註冊組', '資訊組', '設備組',
        '學務處', '生教組', '訓育組', '衛生組', '體育組', '健康中心',
        '總務處', '出納組', '文書組', '事務組',
        '輔導處', '輔導組', '特教組', '生涯組'
      ];
    }

    // 注意：只能在 isAuthorizedPublisher() 為 true 之後呼叫（目前僅 announcements 的 allow create）。
    // 前置檢查已保證：已登入、發布者資料存在、enabled == true、role 為 systemAdmin 或 publisher，
    // 因此這裡重用已讀取的發布者資料，以 role == 'systemAdmin' 判斷管理者，結果等同 isEnabledSystemAdmin()。
    // 若未來要在其他地方使用，必須改回 isEnabledSystemAdmin() 或先完成相同的前置檢查。
    function canCreateAnnouncementDepartment() {
      let publisher = get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data;
      return publisher.role == 'systemAdmin'
        || (publisher.role == 'publisher'
          && request.resource.data.department == publisher.defaultDepartment);
    }

    function canUpdateAnnouncementDepartment() {
      let publisher = get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data;
      return isEnabledSystemAdmin()
        || (publisher.role == 'publisher'
          && request.resource.data.department == publisher.defaultDepartment
          && request.resource.data.department == resource.data.department);
    }

    // 只由 isValidAttachment 呼叫，上層已確認 attachment is map。
    function isValidImageAttachment(attachment) {
      return attachment.type == 'image'
        && attachment.id is string
        && attachment.id.size() > 0
        && attachment.url is string
        && attachment.url.matches('https://.*')
        && attachment.name is string
        && attachment.name.size() > 0;
    }

    // 只由 isValidAttachment 呼叫，上層已確認 attachment is map。
    // 欄位數剛好 7 個且全部屬於允許清單，等同原本「全部都要有」加「只能有這些」。
    // pdfPathPrefix 為 'announcements/{announcementId}/pdf/{publisherUid}/'；無法組成時為 null，PDF 一律拒絕。
    function isValidPdfAttachment(attachment, pdfPathPrefix) {
      return attachment.keys().size() == 7
        && attachment.keys().hasOnly(['id', 'type', 'url', 'name', 'sizeBytes', 'storagePath', 'contentType'])
        && attachment.type == 'pdf'
        && attachment.id is string
        && attachment.id.size() > 0
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.name.size() <= 120
        && attachment.url is string
        && attachment.url.matches('https://.*')
        && attachment.sizeBytes is int
        && attachment.sizeBytes > 0
        && attachment.sizeBytes <= 5 * 1024 * 1024
        && attachment.contentType == 'application/pdf'
        && pdfPathPrefix is string
        && attachment.storagePath == pdfPathPrefix + attachment.id + '.pdf';
    }

    // 依類型分流：圖片只跑圖片檢查、PDF 只跑 PDF 檢查；其他類型兩者皆不符合而拒絕。
    function isValidAttachment(attachment, pdfPathPrefix) {
      return attachment is map
        && (attachment.type == 'image'
          ? isValidImageAttachment(attachment)
          : isValidPdfAttachment(attachment, pdfPathPrefix));
    }

    // 附件清單、數量與 PDF 路徑前段只計算一次，再交給 isValidAttachmentList 驗證。
    function isValidAttachments(data, announcementId, publisherUid) {
      return !data.keys().hasAny(['attachments'])
        || (data.attachments is list
          && isValidAttachmentList(
            data.attachments,
            data.attachments.size(),
            publisherUid is string ? 'announcements/' + announcementId + '/pdf/' + publisherUid + '/' : null));
    }

    // 最多 7 件、每件逐一完整驗證；之後只需確認類型，維持「前段必須是圖片、最多兩份 PDF 排在最後」。
    function isValidAttachmentList(attachments, count, pdfPathPrefix) {
      return count <= 7
        && (count < 1 || isValidAttachment(attachments[0], pdfPathPrefix))
        && (count < 2 || isValidAttachment(attachments[1], pdfPathPrefix))
        && (count < 3 || isValidAttachment(attachments[2], pdfPathPrefix))
        && (count < 4 || isValidAttachment(attachments[3], pdfPathPrefix))
        && (count < 5 || isValidAttachment(attachments[4], pdfPathPrefix))
        && (count < 6 || isValidAttachment(attachments[5], pdfPathPrefix))
        && (count < 7 || isValidAttachment(attachments[6], pdfPathPrefix))
        && (count < 3 || attachments[0].type == 'image')
        && (count < 4 || attachments[1].type == 'image')
        && (count < 5 || attachments[2].type == 'image')
        && (count < 6 || attachments[3].type == 'image')
        && (count < 7 || attachments[4].type == 'image');
    }

    function keepsValidAttachments(announcementId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['attachments'])
        || isValidAttachments(request.resource.data, announcementId, request.resource.data.publisherUid);
    }

    function keepsLegacyFollowUps() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followUps']);
    }

    function isValidContact(data) {
      return !data.keys().hasAny(['contact'])
        || (data.contact is map
          && data.contact.keys().hasAll(['department', 'extension'])
          && data.contact.keys().hasOnly(['department', 'extension'])
          && data.contact.department is string
          && data.contact.department.size() > 0
          && data.contact.department.size() <= 30
          && data.contact.extension is string
          && data.contact.extension.matches('^[0-9]{2,6}$'));
    }

    function isValidLineNotificationSettings(data) {
      return (!data.keys().hasAny(['lineNotificationLevel'])
          || data.lineNotificationLevel in ['schoolwide', 'required', 'task', 'general'])
        && (!data.keys().hasAny(['audienceNote'])
          || (data.audienceNote is string
            && data.audienceNote.size() > 0
            && data.audienceNote.size() <= 40));
    }

    function isOwnVerifiedPublisherRequest(publisherUid) {
      return request.auth != null
        && request.auth.uid == publisherUid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isValidNewPublisherRequest() {
      return request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'requestedAt',
          'lastSeenAt',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'requestedAt',
          'lastSeenAt',
          'status',
          'requestedDepartment'
        ])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && request.resource.data.requestedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['requestedDepartment'])
          || isFixedDepartment(request.resource.data.requestedDepartment)
          || request.resource.data.requestedDepartment == '其他');
    }

    function canCreateAnnouncementFollowUp(announcementId) {
      let ownerUid = get(/databases/$(database)/documents/announcements/$(announcementId)).data.publisherUid;
      return isAuthorizedPublisher()
        && ((request.resource.data.type in ['supplement', 'reminder']
            && (isEnabledSystemAdmin() || ownerUid == request.auth.uid))
          || (request.resource.data.type == 'related'
            && (isEnabledSystemAdmin() || ownerUid != request.auth.uid)));
    }

    function isValidNewAnnouncementFollowUp() {
      let publisher = get(/databases/$(database)/documents/authorizedPublishers/$(request.auth.uid)).data;
      return request.resource.data.keys().hasAll([
          'type',
          'message',
          'authorUid',
          'department',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'message',
          'authorUid',
          'department',
          'authorDisplayName',
          'status',
          'createdAt'
        ])
        && request.resource.data.type in ['supplement', 'reminder', 'related']
        && request.resource.data.status == 'active'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.department == publisher.defaultDepartment
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.department.size() <= 30
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['authorDisplayName'])
          || (publisher.displayName is string
            && publisher.displayName.size() > 0
            && publisher.displayName.size() <= 100
            && request.resource.data.authorDisplayName == publisher.displayName));
    }

    function canUpdateRelatedFollowUp() {
      return isAuthorizedPublisher()
        && resource.data.type == 'related'
        && (isEnabledSystemAdmin() || resource.data.authorUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt'])
        && request.resource.data.type == resource.data.type
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.department == resource.data.department
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.updatedAt == request.time;
    }

    function canDeleteRelatedFollowUp() {
      return isAuthorizedPublisher()
        && resource.data.type == 'related'
        && (isEnabledSystemAdmin() || resource.data.authorUid == request.auth.uid);
    }

    function canWithdrawOriginalFollowUp() {
      return isAuthorizedPublisher()
        && resource.data.type in ['supplement', 'reminder']
        && (!resource.data.keys().hasAny(['status']) || resource.data.status == 'active')
        && (isEnabledSystemAdmin() || resource.data.authorUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy'])
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.withdrawnAt == request.time
        && request.resource.data.withdrawnBy == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAuthorizedPublisher()
        && request.resource.data.publisherUid == request.auth.uid
        && request.resource.data.publicationStatus == 'published'
        && !request.resource.data.keys().hasAny(['hasRelatedFollowUp', 'latestFollowUp', 'followUpCounts', 'contentUpdatedAt', 'contentUpdateCount'])
        && canCreateAnnouncementDepartment()
        && isValidContact(request.resource.data)
        && isValidLineNotificationSettings(request.resource.data)
        && isValidAttachments(request.resource.data, announcementId, request.auth.uid);
      allow update: if canManageAnnouncement()
        && keepsLifecycleFields()
        && keepsServerManagedSummary()
        && keepsContentUpdateCount()
        && keepsLegacyFollowUps()
        && canUpdateAnnouncementDepartment()
        && isValidContact(request.resource.data)
        && isValidLineNotificationSettings(request.resource.data)
        && keepsValidAttachments(announcementId);
      allow delete: if false;

      match /followUps/{followUpId} {
        allow read: if true;
        allow create: if canCreateAnnouncementFollowUp(announcementId)
          && isValidNewAnnouncementFollowUp();
        allow update: if canUpdateRelatedFollowUp() || canWithdrawOriginalFollowUp();
        allow delete: if canDeleteRelatedFollowUp();
      }
    }

    match /authorizedPublishers/{publisherUid} {
      allow get: if request.auth != null && request.auth.uid == publisherUid;
      allow list, create, update, delete: if false;
    }

    match /publisherRequests/{publisherUid} {
      allow get: if (request.auth != null && request.auth.uid == publisherUid)
        || isEnabledSystemAdmin();
      allow list: if isEnabledSystemAdmin();
      allow create: if isOwnVerifiedPublisherRequest(publisherUid)
        && isValidNewPublisherRequest();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
